flowchart TB
  main[main.py<br/>punto de entrada]
  subgraph gui[gui/ — interfaz Tkinter]
    gui1[app, login, vistas por rol]
  end
  subgraph engine[engine/ — motor de visión]
    eng1[security_engine]
  end
  subgraph core[core/ — servicios]
    c1[detector · gpu · face_utils · plate_utils]
    c2[live_stream · hires_stream · camera_manager]
    c3[session · cloud · licencia · security · cifrado · registro_remoto]
  end
  db[database.py<br/>acceso a SQLite]
  rep[reports/<br/>PDF y CSV]
  mig[(migraciones/<br/>esquema SQLite)]
  mod[(modelos/<br/>RF-DETR · YOLOv8n · YuNet · SFace)]
  subgraph srv[servidor/ — se ejecuta en la nube]
    s1[api · registro_movil · central_db]
  end
  tools[tools/<br/>calibración y auditoría]
  tests[tests/<br/>pruebas automáticas]
  main --> gui
  gui --> engine & core & db & rep
  engine --> core & db
  core --> db & mod
  db --> mig
  rep --> db
  srv --> core
  tests -.-> gui & engine & core & db & srv
  tools -.-> core & db
