classDiagram
  direction LR
  class UmbralGuardianApp {
    +navigate(clave)
    +set_db_status(conectada)
  }
  class MonitorView {
    +stop_engine()
    +refresh_cameras()
  }
  class CameraSlot {
    +apply_camera_changes()
  }
  class SecurityEngine {
    +start(cam)
    +stop()
    +toggle_pause()
    -_process_frame()
    -_do_recognition()
    -_reverify()
  }
  class OnnxDetector {
    +detect(imagen, clases)
  }
  class LiveStream {
    +start()
    +read()
    +release()
  }
  class HighResStream {
    +start()
    +get_frame()
    +stop()
  }
  class IoUTracker {
    +update(detecciones)
  }
  class face_utils {
    <<módulo>>
    +load_known_faces(db)
    +recognize_face(imagen, conocidos)
    +assign_person_ids()
    +draw_persons()
  }
  class plate_utils {
    <<módulo>>
    +read_license_plate()
    +get_car()
  }
  class DatabaseManager {
    +get_plantillas_activas()
    +add_deteccion_rostro()
    +add_deteccion_vehiculo()
    +purgar_datos_vencidos()
    +exportar_residente()
  }
  class Session {
    +rol
    +offline
    +dias_restantes
  }
  class cloud {
    <<módulo>>
    +login()
    +sincronizar()
  }
  class registro_remoto {
    <<módulo>>
    +crear_invitacion()
    +descargar()
  }
  class ReportGenerator {
    +export_pdf()
    +export_csv()
  }
  UmbralGuardianApp "1" o-- "*" MonitorView : vistas
  MonitorView "1" *-- "2" CameraSlot
  CameraSlot "1" *-- "1" SecurityEngine
  SecurityEngine --> LiveStream : canal bajo
  SecurityEngine --> HighResStream : canal alto
  SecurityEngine --> OnnxDetector : RF-DETR y patentes
  SecurityEngine --> IoUTracker : vehículos
  SecurityEngine ..> face_utils : YuNet + SFace
  SecurityEngine ..> plate_utils : OCR
  SecurityEngine --> DatabaseManager : registra eventos
  UmbralGuardianApp ..> Session
  Session ..> cloud : inicio de sesión
  registro_remoto ..> cloud
  registro_remoto --> DatabaseManager
  ReportGenerator --> DatabaseManager
