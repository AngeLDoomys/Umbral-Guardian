# /etc/umbral/api.env — configuración de la API central en el servidor.
# Solo lo lee el servicio umbral-api (permisos 600). NUNCA va en el programa
# que se instala en los condominios.

# Base central en RDS (Amazon RDS -> la base -> "Punto de enlace")
UG_CENTRAL_HOST=umbral-central.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
UG_CENTRAL_PORT=3306
UG_CENTRAL_USER=admin
UG_CENTRAL_PASSWORD=CAMBIAR_POR_LA_CLAVE_MAESTRA_DE_RDS
UG_CENTRAL_DATABASE=umbral_central

# La API solo escucha dentro del servidor; Caddy la publica con HTTPS
UG_API_HOST=127.0.0.1
UG_API_PORT=5000
